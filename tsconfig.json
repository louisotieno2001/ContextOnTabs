{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "plasmo/templates/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~*": [
        "./*",
        "./src/*",
        "./src/pages/*"
      ]
    },
    "strict": true,
    "types": [
      "chrome",
      "node"
    ]
  },
  "include": [
    ".plasmo/index.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
