{
  "name": "cots",
  "displayName": "COTS",
  "version": "0.1.0",
  "description": "A Chrome extension for creating floating AI context panels from highlighted browser content.",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv2",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv2",
    "package": "plasmo package",
    "package:firefox": "plasmo package --target=firefox-mv2",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "plasmo": "0.90.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^20.19.39",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "activeTab"
    ],
    "host_permissions": [
      "https://api.openai.com/*",
      "https://api.anthropic.com/*",
      "https://generativelanguage.googleapis.com/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "context-on-tabs@example.org"
      }
    }
  }
}
